<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <RootNamespace>Aixaminator</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AssemblyTitle>Aixaminator</AssemblyTitle>
        <Product>Aixaminator</Product>
        <Version>2.0.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <!-- UI -->
        <PackageReference Include="Avalonia" Version="12.1.3" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
         </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />

        <!-- Persistence -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!-- Pin transitive dependencies of the EF Core design-time tooling to the versions used by the rest of
             the graph; otherwise restore has to look up older minimum versions from a feed. -->
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4" PrivateAssets="all" />

        <!-- Hosting / infrastructure -->
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
        <!-- AI -->
        <PackageReference Include="Microsoft.SemanticKernel" Version="1.80.1" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Importers\Importers.csproj" />
    </ItemGroup>

</Project>
