<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aixaminator.ViewModels.Document"
             xmlns:conv="using:Aixaminator.Converters"
             xmlns:behaviors="using:Aixaminator.Behaviors"
             x:Class="Aixaminator.Views.Document.StudyView"
             x:DataType="vm:StudyViewModel">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="ToggleShowAllButton" Classes="accent" MinWidth="120" HorizontalContentAlignment="Center"
                    Content="{Binding ToggleShowAllText}" Command="{Binding ToggleShowAllCommand}" />
        </StackPanel>

        <ScrollViewer behaviors:ScrollReset.Trigger="{Binding PartNumber}">
            <StackPanel Spacing="12" Margin="0,0,12,0">
                <TextBlock x:Name="Heading" Classes="h2" Text="{Binding Heading}" />
                <TextBlock x:Name="EmptyMessage" Text="{Binding EmptyMessage}" IsVisible="{Binding IsEmpty}" />

                <ItemsControl x:Name="NoteList" ItemsSource="{Binding Notes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:StudyNoteViewModel">
                            <Border Classes="card" Margin="0,0,0,12">
                                <StackPanel Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <Panel Width="16" Height="16" VerticalAlignment="Center">
                                            <Path Classes="stroke-icon" Data="{StaticResource Icon.Question}" IsVisible="{Binding IsQuestion}" />
                                            <Ellipse IsVisible="{Binding IsHighlight}"
                                                     Fill="{Binding HighlightColour, Converter={x:Static conv:AppConverters.HexToBrush}}" />
                                            <Path Classes="stroke-icon" Data="{StaticResource Icon.Note}" IsVisible="{Binding IsPlainNote}" />
                                        </Panel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding KindLabel}" FontWeight="Medium" />
                                            <TextBlock Classes="hint" Text="{Binding PartName}" VerticalAlignment="Center"
                                                       IsVisible="{Binding $parent[ItemsControl].((vm:StudyViewModel)DataContext).ShowAll}" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="danger" Content="Delete"
                                                ToolTip.Tip="Delete this note" Command="{Binding DeleteCommand}" />
                                    </Grid>

                                    <StackPanel IsVisible="{Binding HasContext}">
                                        <TextBlock Classes="label" Text="Reference text" />
                                        <TextBlock Text="{Binding Context}" TextWrapping="Wrap" FontStyle="Italic" />
                                    </StackPanel>

                                    <StackPanel Spacing="10" IsVisible="{Binding IsQuestion}">
                                        <StackPanel>
                                            <TextBlock Classes="label" Text="Question" />
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Classes="label" Text="Answer" />
                                            <Button Classes="accent" Content="Show Answer" HorizontalAlignment="Left"
                                                    Command="{Binding ToggleAnswerCommand}" IsVisible="{Binding !IsAnswerVisible}" />
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" IsVisible="{Binding IsAnswerVisible}">
                                                <Button Command="{Binding ToggleAnswerCommand}" ToolTip.Tip="Hide answer" Padding="6">
                                                    <Path Classes="stroke-icon" Data="{StaticResource Icon.EyeSlash}" />
                                                </Button>
                                                <TextBlock Grid.Column="1" Text="{Binding Answer}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" IsVisible="{Binding !IsQuestion}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
