<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Typography -->
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h3">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.hint">
        <Setter Property="Foreground" Value="{DynamicResource MutedForegroundBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.error">
        <Setter Property="Foreground" Value="{DynamicResource ErrorForegroundBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.success">
        <Setter Property="Foreground" Value="{DynamicResource SuccessForegroundBrush}" />
    </Style>

    <!-- Containers -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.error-banner">
        <Setter Property="Background" Value="{DynamicResource ErrorBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorForegroundBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="Border.dialog">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="BoxShadow" Value="0 8 24 0 #40000000" />
    </Style>
    <Style Selector="Separator">
        <Setter Property="Margin" Value="0,4" />
    </Style>

    <!-- Buttons. "accent" (from Fluent) is the primary style. -->
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- AI-powered features -->
    <Style Selector="Button.premium">
        <Setter Property="Background" Value="{DynamicResource PremiumBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.premium:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PremiumHoverBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.premium:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PremiumHoverBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Round colour swatches (highlight and part colours) -->
    <Style Selector="Button.swatch">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    </Style>
    <Style Selector="Button.swatch:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Opacity" Value="0.8" />
    </Style>

    <!-- Parts in the document sidebar -->
    <Style Selector="Button.part">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.part.read">
        <Setter Property="Background" Value="{DynamicResource ReadPartBrush}" />
    </Style>
    <Style Selector="Button.part.current">
        <Setter Property="Background" Value="{DynamicResource CurrentPartBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.part:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource PartHoverBrush}" />
    </Style>

    <!-- Outline icons -->
    <Style Selector="Path.stroke-icon">
        <Setter Property="Stroke" Value="{DynamicResource IconBrush}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>
    <Style Selector="PathIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>

    <!-- The reader keeps the user's colours when the editor has focus or is hovered -->
    <Style Selector="TextBox.reader /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{Binding $parent[TextBox].Background}" />
    </Style>
    <Style Selector="TextBox.reader:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{Binding $parent[TextBox].Background}" />
    </Style>
    <Style Selector="TextBox.reader:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{Binding $parent[TextBox].Background}" />
    </Style>

    <!-- Quiz feedback -->
    <Style Selector="RadioButton.answer">
        <Setter Property="Margin" Value="0,2" />
    </Style>
</Styles>
