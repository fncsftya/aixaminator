@using Aixaminator.Data
@using Aixaminator.Features
@using Microsoft.Extensions.Logging

@inject AppDbContext Context

<div class="overflow-hidden rounded-lg bg-white shadow-sm outline-1 outline-gray-300 -outline-offset-1">
    <div class="px-2 py-3">
        <EditForm EditContext="editContext">
            <div class="w-full flex flex-col gap-y-2">
                @* Name *@
                <div>
                    <label for="dps__name" class="block text-sm/6 font-medium text-gray-900">Name</label>
                    <div class="mt-1">
                        <InputText @bind-Value="model.Name" id="dps__name" title="Name of this part" class="block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-teal-600 sm:text-sm/6" />
                    </div>
                </div>

                @* Colour *@
                <div>
                    <label class="block text-sm/6 font-medium text-gray-900">Custom Colour</label>
                    <div class="flex items-center gap-x-4">

                        <label for="dps__colour_checkbox" class="block text-sm/6 font-medium text-gray-900">Enable?</label>

                        @* Checkbox monstrosity *@
                        <div class="flex h-6 shrink-0 items-center">
                            <div class="group grid size-4 grid-cols-1">
                                <InputCheckbox @bind-Value="model.UseCustomColour" id="dps__colour_checkbox" title="Use custom colour?" type="checkbox" class="col-start-1 row-start-1 appearance-none rounded-sm border border-gray-300 bg-white checked:border-teal-600 checked:bg-teal-600 indeterminate:border-teal-600 indeterminate:bg-teal-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-600 disabled:border-gray-300 disabled:bg-gray-100 disabled:checked:bg-gray-100 forced-colors:appearance-auto" />
                                <svg class="pointer-events-none col-start-1 row-start-1 size-3.5 self-center justify-self-center stroke-white group-has-disabled:stroke-gray-950/25" viewBox="0 0 14 14" fill="none">
                                    <path class="opacity-0 group-has-checked:opacity-100" d="M3 8L6 11L11 3.5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                    <path class="opacity-0 group-has-indeterminate:opacity-100" d="M3 7H11" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                                </svg>
                            </div>
                        </div>

                        <label for="dps__colour_input" class="block text-sm/6 font-medium text-gray-900">Choice</label>

                        @* Colour picker *@
                        <div class="colour-picker">
                            <InputText @bind-value="model.Colour" type="color" id="dps__colour_input" title="Choose a colour for this section" />
                        </div>

                    </div>
                </div>

                <hr class="block border-t border-gray-300" />

                @* Hide *@
                <div>
                    <button type="button" class="negative" @onclick="HidePart">Hide Part</button>
                </div>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter]
    public Guid DocumentId { get; set; }
    [Parameter]
    public DocumentPart? DbPart { get; set; }

    [Parameter]
    public int PartNumber { get; set; }

    private DocumentPart part { get; set; }

    private DocumentPartSettingsModel model;
    private EditContext editContext;

    [Parameter]
    public EventCallback OnSettingsChanged { get; set; }

    protected override async Task OnInitializedAsync()
    {
        part = await DocumentParts.GetAsync(Context, DocumentId, PartNumber);
        model = DocumentPartSettingsModel.FromDb(part);
        editContext = new EditContext(model);
        editContext.OnFieldChanged += async (sender, evt) =>
        {
            model.UpdatePart(part);
            await Context.SaveChangesAsync();
            await OnSettingsChanged.InvokeAsync();
        };
    }

    public async Task HidePart()
    {
        part.Hidden = true;
        await Context.SaveChangesAsync();
        await OnSettingsChanged.InvokeAsync();
    }

    private class DocumentPartSettingsModel
    {
        public string? Name { get; set; }
        public bool UseCustomColour { get; set; }
        public string? Colour { get; set; }

        public static DocumentPartSettingsModel FromDb(DocumentPart part)
        {
            return new DocumentPartSettingsModel
                {
                    Name = part.Name,
                    UseCustomColour = part.UseColour,
                    Colour = part.Colour,
                };
        }

        public void UpdatePart(DocumentPart part)
        {
            if (string.IsNullOrWhiteSpace(Name))
            {
                part.Name = null;
            }
            else
            {
                part.Name = Name;
            }
            part.UseColour = UseCustomColour;
            part.Colour = Colour;
        }
    }
}