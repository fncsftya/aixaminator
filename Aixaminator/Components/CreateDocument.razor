@using Aixaminator.Data
@using System.Text
@using Aixaminator.Utils
@using System.Text.RegularExpressions
@using Importers

@inject AppDbContext Context

<div class="w-full md:w-1/2 mx-auto">
    <h3>Add Document</h3>

    @if (failureMessage.Length > 0)
    {
        <p class="text-danger">@failureMessage</p>
    }
    else if (status == PipelineStatus.NotStarted)
    {
        <div class="my-4">
            <nav class="flex space-x-4" aria-label="Import Tabs">
                <button type="button" 
                @onclick="() => SetActiveTab(ImportTab.File)"
                class="rounded-md px-3 py-2 text-sm font-medium @(activeTab == ImportTab.File ? "w-24 bg-teal-600 text-teal-50 hover:bg-teal-700 hover:text-teal-100" : "w-24 bg-gray-100 text-gray-500 hover:text-gray-700")"
                aria-current="@(activeTab == ImportTab.File ? "page" : null)">
                    Local File
                </button>
                <button type="button" 
                @onclick="() => SetActiveTab(ImportTab.Url)"
                class="rounded-md px-3 py-2 text-sm font-medium @(activeTab == ImportTab.Url ? "w-24 bg-teal-600 text-teal-50 hover:bg-teal-700 hover:text-teal-100" : "w-24 bg-gray-100 text-gray-500 hover:text-gray-700")"
                aria-current="@(activeTab == ImportTab.Url ? "page" : null)">
                    Web
                </button>
            </nav>
        </div>
        <div>
            <EditForm Model="@importModel" OnValidSubmit="HandleValidSubmit">
                <DataAnnotationsValidator />

                @if (activeTab == ImportTab.File)
                {
                    <div>
                        <label for="fileInput" class="block text-sm/6 font-medium text-gray-900">Choose a file</label>
                        <div class="mt-2 flex w-full">
                            <div class="-mr-px grid grow grid-cols-1 focus-within:relative">
                                <InputFile OnChange="HandleFileSelected" id="fileInput" class="col-start-1 row-start-1 block w-full rounded-l-md bg-white py-1.5 pr-3 pl-10 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-teal-600 sm:pl-9 sm:text-sm/6" />
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="pointer-events-none col-start-1 row-start-1 ml-3 size-5 self-center text-gray-400 sm:size-4">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0 4.5 4.5M12 3v13.5" />
                                </svg>
                            </div>
                            @* A label opens the picker natively; a JS-triggered click loses the user gesture WebKit requires *@
                            <label for="fileInput" class="flex shrink-0 cursor-pointer items-center gap-x-1.5 rounded-r-md bg-white px-3 py-2 text-sm font-semibold text-gray-900 outline-1 -outline-offset-1 outline-gray-300 hover:bg-gray-50 focus:relative focus:outline-2 focus:-outline-offset-2 focus:outline-teal-600">
                                Browse
                            </label>
                        </div>
                        <ValidationMessage For="@(() => importModel.SelectedFile)" class="mt-2 text-sm text-red-600" />
                    </div>
                }
                else if (activeTab == ImportTab.Url)
                {
                    <div>
                        <label for="url-input" class="block text-sm/6 font-medium text-gray-900">Enter URL</label>
                        <div class="mt-2 w-full">
                            <InputText @bind-Value="importModel.Url" id="url-input" class="block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-teal-600 sm:text-sm/6" placeholder="https://en.wikipedia.org/wiki/Example" />
                        </div>
                        <ValidationMessage For="@(() => importModel.Url)" class="mt-2 text-sm text-red-600" />
                        @if (activeTab == ImportTab.Url && !string.IsNullOrEmpty(importModel.Url) && !IsValidUrl(importModel.Url))
                        {
                            <div class="mt-1 text-sm text-red-600">Please enter a valid URL</div>
                        }
                    </div>
                }

                <div class="mt-3 mb-3 rounded-md border border-dashed border-gray-300 bg-gray-50 px-3 py-2">
                    <span class="block text-sm font-medium text-gray-500">Split document into parts</span>
                    <span class="block text-sm text-gray-500 mt-0.5">Automatic splitting and classification are not yet available on macOS or Linux.</span>
                </div>

                <div class="mt-3 mb-3 flex flex-col">
                    <label for="document-description" class="block text-sm/6 font-medium text-gray-900">Document Summary</label>
                    <div class="mt-2">
                        <InputTextArea @bind-Value="documentDescription" id="document-description" class="block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-teal-600 sm:text-sm/6" placeholder="Provide a summary of this document" />
                    </div>
                    <span class="text-gray-500 text-sm mt-2">This will help the AI give more accurate quizzes.</span>
                </div>

                <button type="submit" class="primary">Create</button>
            </EditForm>
        </div>
    }
    else if (status == PipelineStatus.Reading)
    {
        <p>Analyzing document...</p>
    }
    else if (status == PipelineStatus.Processing)
    {
        <p>Processing document...</p>
    }
    else if (status == PipelineStatus.Completed && document is not null)
    {
        <p>Done! <NavLink href=@($"/view/{document.Id}")>View your document</NavLink>.</p>
    }
    else
    {
        <p>Something went wrong.</p>
    }
</div>

@code {
    private ImportModel importModel = new ImportModel();
    private string failureMessage = string.Empty;
    private PipelineStatus status = PipelineStatus.NotStarted;
    private ImportTab activeTab = ImportTab.File;
    private string documentDescription = string.Empty;

    private Document? document = null;

    private void SetActiveTab(ImportTab tab)
    {
        activeTab = tab;
        failureMessage = string.Empty;
    }

    private void HandleTabChange(ChangeEventArgs e)
    {
        if (Enum.TryParse<ImportTab>(e.Value?.ToString(), out var tab))
        {
            SetActiveTab(tab);
        }
    }

    private bool IsValidUrl(string url)
    {
        return Uri.TryCreate(url, UriKind.Absolute, out var uriResult) 
            && (uriResult.Scheme == Uri.UriSchemeHttp || uriResult.Scheme == Uri.UriSchemeHttps);
    }

    private bool IsWikipediaUrl(string url)
    {
        return IsValidUrl(url) && url.Contains("wikipedia.org");
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        importModel.SelectedFile = file;
    }

    private Regex wsRegex = new(@"\s+");

    private async Task HandleValidSubmit()
    {
        failureMessage = string.Empty;

        if (activeTab == ImportTab.File && importModel.SelectedFile == null)
        {
            failureMessage = "No file selected";
            return;
        }

        if (activeTab == ImportTab.Url && string.IsNullOrEmpty(importModel.Url))
        {
            failureMessage = "No URL provided";
            return;
        }

        if (activeTab == ImportTab.Url && !IsValidUrl(importModel.Url))
        {
            failureMessage = "Invalid URL format";
            return;
        }

        string documentText;
        string name;

        status = PipelineStatus.Reading;
        StateHasChanged();

        try
        {
            if (activeTab == ImportTab.File)
            {
                // Handle file upload
                using var memoryStream = new MemoryStream();
                await importModel.SelectedFile.OpenReadStream(maxAllowedSize: 300 * 1024 * 1024).CopyToAsync(memoryStream);
                memoryStream.Position = 0;

                var contentType = importModel.SelectedFile.ContentType.ToLower();
                var fileName = importModel.SelectedFile.Name.ToLower();

                // Check file type and extract text accordingly
                if (contentType == "application/pdf")
                {
                    // Handle PDF files
                    var pdfReader = new PDFReader();
                    memoryStream.Position = 0;
                    documentText = pdfReader.ExtractText(memoryStream);
                }
                else if (contentType == "application/epub+zip" || contentType == "application/epub" || fileName.EndsWith(".epub"))
                {
                    // Handle EPUB files
                    var epubReader = new EpubReader();
                    memoryStream.Position = 0;

                    // Check if it's a valid EPUB file first
                    try
                    {
                        documentText = epubReader.ExtractText(memoryStream);
                    }
                    catch (Exception ex)
                    {
                        failureMessage = "The chosen file is not a valid EPUB file.";
                        status = PipelineStatus.NotStarted;
                        StateHasChanged();
                        return;
                    }
                }
                else
                {
                    // For non-PDF/non-EPUB files, read as text directly
                    memoryStream.Position = 0;

                    // Check if the file contains binary content
                    if (await FileUtils.IsBinaryContent(memoryStream))
                    {
                        failureMessage = "The chosen file appears to contain binary content and cannot be processed as text.";
                        status = PipelineStatus.NotStarted;
                        StateHasChanged();
                        return;
                    }

                    // Reset position and continue with text reading
                    memoryStream.Position = 0;
                    using var streamReader = new StreamReader(memoryStream);
                    documentText = await streamReader.ReadToEndAsync();
                }

                name = Path.GetFileNameWithoutExtension(importModel.SelectedFile.Name);
            }
            else // URL tab
            {
                // Handle URL import
                if (IsWikipediaUrl(importModel.Url))
                {
                    // Use WikiReader for Wikipedia URLs
                    var wikiReader = new WikiReader();
                    documentText = await wikiReader.ExtractTextFromUrlAsync(importModel.Url);

                    // Extract page title from URL for the document name
                    var pageTitle = importModel.Url.Split('/').LastOrDefault();
                    name = !string.IsNullOrEmpty(pageTitle) ? Uri.UnescapeDataString(pageTitle) : "Wikipedia Page";
                }
                else
                {
                    // For other URLs, we could implement other readers in the future
                    failureMessage = "Only Wikipedia URLs are currently supported.";
                    status = PipelineStatus.NotStarted;
                    StateHasChanged();
                    return;
                }
            }

            // figure out the directory for the document
            string dirPath;
            int n = 0;
            do
            {
                dirPath = wsRegex.Replace(
                        string.Join("", name.Where(c => char.IsAsciiLetterOrDigit(c) || char.IsWhiteSpace(c))), "_"
                    )
                    .Trim();
                if (dirPath.Length > 50)
                {
                    dirPath = dirPath.Substring(0, 50);
                }
                if (n > 0)
                {
                    dirPath += $"_{n}";
                }
                n++;
            } while (Directory.Exists(Constants.GetInternalFilepath("Documents", dirPath)));

            var docPath = Constants.GetInternalFilepath("Documents", dirPath);

            Directory.CreateDirectory(docPath);

            status = PipelineStatus.Processing;
            StateHasChanged();

            // Document splitting is not available, so write the entire document to a single file
            await File.WriteAllTextAsync(Path.Combine(docPath, "0.txt"), documentText);

            document = await Features.Documents.New(
                Context, 
                name, 
                dirPath,
                !string.IsNullOrWhiteSpace(documentDescription) ? documentDescription : null
            );

            // Create a single DocumentPart for the entire document
            await Features.DocumentParts.GetAsync(Context, document.Id, 0);

            status = PipelineStatus.Completed;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            failureMessage = $"Error processing content: {ex.Message}";
            status = PipelineStatus.NotStarted;
            StateHasChanged();
        }
    }

    private enum ImportTab
    {
        File,
        Url
    }

    private class ImportModel
    {
        public IBrowserFile? SelectedFile { get; set; }
        public string Url { get; set; } = string.Empty;
    }

    private enum PipelineStatus
    {
        NotStarted,
        Reading,
        Processing,
        Completed
    }
}