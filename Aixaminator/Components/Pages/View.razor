@page "/view/{id}"

@using Aixaminator.Data
@using Aixaminator.Features
@using Aixaminator.Services
@using Microsoft.EntityFrameworkCore
@using System.Text
@using System.Text.RegularExpressions
@using Microsoft.EntityFrameworkCore.ChangeTracking
@using Microsoft.Extensions.Logging
@using System.Text.Json
@using System.Diagnostics
@using Aixaminator.Components
@using Aixaminator.Components.Modes

@implements IAsyncDisposable

@inject AppDbContext Context
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<View> Log
@inject ISettingsService SettingsService
@inject IAiConnection AiConnection

<AddNoteModal Open="addingNote"
              OpenChanged="(value) => addingNote = value"
              OnSave="SaveNote"
              OnClose="CloseNoteModal"
              ExtraContext="@noteContext?.Text"
              IsQuestion="addingQuestion" />

<ConfirmationModal Open="showingMoveConfirmation"
                   OpenChanged="(value) => showingMoveConfirmation = value"
                   Title="No notes taken"
                   Message="You haven't taken any notes for this section. Would you like to continue without adding notes?"
                   OnContinue="ContinueWithoutNotes"
                   OnCancel="CancelMove" />

@if (Id is null || loadFailed)
{
    <p>An error occurred whilst loading the document.</p>
}
else if (document is null)
{
    <p>Loading</p>
}
else
{
    <DocumentLayout 
        Document="document" 
        Details="details"
        IsEditing="isEditing"
        IsStudying="isStudying"
        IsConfiguring="isConfiguring"
        IsRecapping="isRecapping"
        CurrentPart="part"
        Parts="parts"
        ShowingPartSettings="showingPartSettings"
        OnViewPart="ViewPart"
        OnModeToggle="ToggleMode"
        OnGoBack="GoBack"
        OnStartEditing="StartEditing"
        OnCancelEditing="CancelEditing"
        OnSaveEdits="SaveEdits"
        OnTogglePartSettings="TogglePartSettings"
        OnFieldUpdated="HandleFieldUpdated"
        OnStartConfiguring="StartConfiguring"
        OnCancelConfiguring="CancelConfiguring"
        OnToggleRead="CheckAndToggleRead">
        
        @if (isConfiguring)
        {
            <div class="h-full flex flex-col gap-y-2">
                <div class="flex-1 overflow-y-auto p-4">
                    <ConfigureMode Document="document" Parts="parts" OnUpdate="RefreshView" />
                </div>

                <div class="flex justify-end">
                    <button class="primary" @onclick="CancelConfiguring">Close</button>
                </div>
            </div>
        }
        else if (isRecapping)
        {
            <div class="h-full flex flex-col gap-y-2">
                <div class="flex-1 overflow-y-auto p-4">
                    <RecapMode Document="document" Parts="parts" OnUpdate="RefreshView" />
                </div>

                <div class="flex justify-end">
                    <button class="primary" @onclick="CancelRecapping">Close</button>
                </div>
            </div>
        }
        else if (active)
        {
            @if (isEditing)
            {
                <EditMode
                    Document="document"
                    Part="part"
                    PartText="@partText"
                    Active="active"
                    ReaderStyle="@(SettingsService.Settings.ReaderStyle)"
                    IsCleaning="isCleaning"
                    CleaningFailed="cleaningFailed"
                    ForPart="forPart"
                    EditedText="@editedText[part]"
                    EditedTextChanged="@((value) => editedText[part] = value)"
                    OnCleanPage="CleanPage" />
            }
            else if (isStudying)
            {
                <div class="h-full flex flex-col gap-y-2">
                    <div class="reader flex-1 overflow-y-auto p-4 bg-white rounded-sm"
                        style="@(SettingsService.Settings.ReaderStyle)">
                        <CascadingValue Value="document">
                            <StudyMode Part="part" ShowAll="isShowingAllNotes" OnUpdate="RefreshView" />
                        </CascadingValue>
                    </div>

                    <div class="flex justify-between items-center">
                        @if (isShowingAllNotes)
                        {
                            <button class="primary w-28" @onclick="() => { isShowingAllNotes = false; }">Show Partial</button>
                        }
                        else
                        {
                            <button class="primary w-28" @onclick="() => { isShowingAllNotes = true; }">Show All</button>
                        }
                        
                        <div></div>
                    </div>
                </div>
            }
            else
            {
                <ReadMode
                    Document="document"
                    Part="part"
                    PartText="@partText" 
                    Active="active"
                    ReaderStyle="@(SettingsService.Settings.ReaderStyle)"
                    OnViewPart="CheckAndNavigatePart"
                    OnAddNote="StartAddingNote"
                    OnSaveHighlight="SaveHighlight" />
            }
        }
    </DocumentLayout>
}

@code {
    [Parameter]
    public string Id { get; set; }

    private Document? document;
    private DocumentLayout.DocumentDetails? details;
    private bool loadFailed = false;

    private bool active = false;
    private int part = 0;
    private string partText = string.Empty;

    private bool isEditing = false;
    private Dictionary<int, string> editedText = new();

    private bool isCleaning = false;
    private bool cleaningFailed = false;
    private int forPart = 0;

    private int? showingPartSettings;
    private Dictionary<int, DocumentPart> parts = new();

    private ReadMode.HighlightState? noteContext = null;
    private bool addingNote = false;
    private bool addingQuestion = false;

    private bool isStudying = false;
    private bool isShowingAllNotes = false;
    
    private bool isConfiguring = false;
    private bool isRecapping = false;

    // For confirmation modal
    private bool showingMoveConfirmation = false;
    private int? pendingPartNavigation = null;
    private int? pendingToggleRead = null;

    private IJSObjectReference? viewModule;

    protected override async Task OnInitializedAsync()
    {
        var id = Guid.Parse(Id);
        document = await Documents.GetAsync(Context, id);
        if (document is null)
        {
            loadFailed = true;
        }
        else
        {
            details = new DocumentLayout.DocumentDetails(document);
            await details.LoadSections();

            if (details.Sections is not null)
            {
                var partsList = await DocumentParts.GetPartsForDocumentAsync(Context, document.Id);
                foreach (var part in partsList)
                {
                    parts[part.PartNumber] = part;
                }

                if (document.PartsRead.Count > 0)
                {
                    var validSections = details.Sections.Where(p => !parts.ContainsKey(p) || !parts[p].Hidden).ToList();
                    
                    if (validSections.Count > 0)
                    {
                        var showPart = Enumerable.Range(0, validSections.Max() + 1)
                            .Where(p => validSections.Contains(p))
                            .Except(document.PartsRead)
                            .FirstOrDefault();
                            
                        if (showPart >= 0 && showPart <= validSections.Max())
                        {
                            part = showPart;
                        }
                    }
                }

                await ViewPart(part);
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            viewModule = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/View.razor.js");
        }
    }

    public void ToggleMode((bool, bool, bool, bool) modeState)
    {
        var (isEdit, isStudy, isConfig, isRecap) = modeState;
        isEditing = isEdit;
        isStudying = isStudy;
        isConfiguring = isConfig;
        isRecapping = isRecap;
        StateHasChanged();
    }

    public void CloseNoteModal()
    {
        noteContext = null;
    }

    public async Task SaveNote((string Text, string? ExtraContext, string? Answer) noteData)
    {
        if (document is null)
        {
            return;
        }

        var documentPart = await UpsertDocumentPart();
        var note = new Note
            {
                Text = noteData.Text,
                Context = noteData.ExtraContext,
                Answer = noteData.Answer,
                Location = noteContext?.Location,
                Document = document,
                Part = documentPart,
            };

        await Context.AddAsync(note);
        await Context.SaveChangesAsync();

        // reset here because modal doesn't clear this when submitting
        noteContext = null;

        StateHasChanged();
    }

    public async Task<DocumentPart> UpsertDocumentPart()
    {
        Debug.Assert(document is not null);

        DocumentPart documentPart;
        if (!parts.ContainsKey(part))
        {
            documentPart = new DocumentPart
                {
                    PartNumber = part,
                    DocumentId = document.Id,
                };
            parts[part] = documentPart;
            await Context.AddAsync(documentPart);
        }
        else
        {
            documentPart = parts[part];
        }

        return documentPart;
    }

    public void StartEditing()
    {
        editedText.Clear();
        editedText[part] = partText;
        isEditing = true;
        cleaningFailed = false;
    }

    public async Task SaveEdits()
    {
        isEditing = false;
        if (document is not null)
        {
            await Documents.SavePartEdits(Context, document, editedText);
            // force reload the notes after editing to prevent crashes
            foreach (var note in document.Notes)
            {
                await Context.Entry(note).ReloadAsync();
            }
        }

        await ViewPart(part);
        StateHasChanged();
    }

    public async Task CleanPage()
    {
        isCleaning = true;
        forPart = part;
        StateHasChanged();

        // TODO need to prevent a part from being cleaned twice
        try
        {
            var aiCleanedText = await AiConnection.CleanPage(partText);

            var cleanedText = new StringBuilder();
            var lines = new Regex(@"\r?\n").Split(aiCleanedText).ToList();

            for (int i = 0; i < lines.Count; i++)
            {
                var line = lines[i];
                if (line.EndsWith("-") && i + 1 < lines.Count && !string.IsNullOrEmpty(lines[i + 1]) && char.IsLetter(lines[i + 1][0]))
                {
                    line = line.TrimEnd('-') + lines[i + 1];
                    i++; // Skip the next line as it has been joined
                }

                var cleanerRegexes = new List<Regex> {
                    new(@"^\d+\D+$"),
                    new(@"^\D+\d+$"),
                    new(@"^\d+$"),
                };

                foreach (var regex in cleanerRegexes)
                {
                    line = regex.Replace(line, string.Empty);
                    if (line != lines[i])
                    {
                        break;
                    }
                }
                cleanedText.AppendLine(line);
            }

            editedText[forPart] = cleanedText.ToString();
        }
        catch (Exception ex)
        {
            cleaningFailed = true;
        }

        isCleaning = false;
        StateHasChanged();
    }

    public void CancelEditing()
    {
        editedText.Clear();
        isEditing = false;
        StateHasChanged();
    }

    public void GoBack()
    {
        Navigation.NavigateTo("/");
    }

    public async Task NavigatePart(int newPart)
    {
        if (document != null)
        {
            await Documents.MarkPartRead(Context, document, part);
        }
        
        await ViewPart(newPart);
    }

    private bool HasNotesForCurrentPart()
    {
        if (document == null)
            return false;
        
        return document.Notes.Any(n => n.DocumentPartNumber == part);
    }

    public async Task CheckAndNavigatePart(int newPart)
    {
        // Check if user has notes for this part before navigating
        if (!HasNotesForCurrentPart() && !isEditing && !isStudying && !isConfiguring)
        {
            pendingPartNavigation = newPart;
            showingMoveConfirmation = true;
            StateHasChanged();
        }
        else
        {
            await NavigatePart(newPart);
        }
    }

    public async Task CheckAndToggleRead(int partToToggle)
    {
        // Check if user has notes for this part before toggling read status
        if (!HasNotesForCurrentPart() && document?.HasRead(partToToggle) == false && !isEditing && !isStudying && !isConfiguring)
        {
            pendingToggleRead = partToToggle;
            showingMoveConfirmation = true;
            StateHasChanged();
        }
        else
        {
            await ToggleRead(partToToggle);
        }
    }

    public async Task ContinueWithoutNotes()
    {
        if (pendingPartNavigation.HasValue)
        {
            int newPart = pendingPartNavigation.Value;
            pendingPartNavigation = null;
            await NavigatePart(newPart);
            
            // Ensure scrolling happens after navigation
            await ScrollToTop();
        }
        else if (pendingToggleRead.HasValue)
        {
            int partToToggle = pendingToggleRead.Value;
            pendingToggleRead = null;
            await ToggleRead(partToToggle);
        }
    }

    public void CancelMove()
    {
        pendingPartNavigation = null;
        pendingToggleRead = null;
        showingMoveConfirmation = false;
        StateHasChanged();
    }

    public async Task ViewPart(int p)
    {
        partText = await Documents.GetPartTextAsync(document!, p);
        part = p;
        if (isEditing && !editedText.ContainsKey(part))
        {
            editedText[part] = partText;
        }
        active = true;
        cleaningFailed = false;
        StateHasChanged();
        
        // Scroll to top after state has changed and component is re-rendered
        await ScrollToTop();
    }

    public async Task ToggleRead(int partToToggle)
    {
        await Documents.TogglePartRead(Context, document, partToToggle);
        StateHasChanged();
    }

    public async Task TogglePartSettings(int p)
    {
        if (showingPartSettings == p)
        {
            showingPartSettings = null;
        }
        else
        {
            showingPartSettings = p;
        }

        StateHasChanged();
    }

    public async Task HandleFieldUpdated()
    {
        if (showingPartSettings is not null)
        {
            var p = (int)showingPartSettings;
            if (parts.ContainsKey(p))
            {
                EntityEntry<DocumentPart> entry = Context.Entry(parts[p]);
                await entry.ReloadAsync();
            }
            else
            {
                parts[p] = await DocumentParts.GetAsync(Context, document.Id, p);
            }

            if (part == p && parts[p].Hidden)
            {
                part = -1;
                active = false;
            }

            StateHasChanged();
        }
    }

    public void StartAddingNote((bool IsQuestion, ReadMode.HighlightState? Context) data)
    {
        addingNote = true;
        noteContext = data.Context;
        addingQuestion = data.IsQuestion;
    }

    public async Task SaveHighlight((string Color, ReadMode.HighlightState HighlightData) data)
    {
        if (document is null)
        {
            return;
        }

        var documentPart = await UpsertDocumentPart();
        var note = new Note
            {
                Text = data.HighlightData.Text,
                Location = data.HighlightData.Location,
                HighlightColour = data.Color,
                Document = document,
                Part = documentPart,
            };

        await Context.AddAsync(note);
        await Context.SaveChangesAsync();
    }

    public void RefreshView()
    {
        StateHasChanged();
    }

    public void StartConfiguring()
    {
        isEditing = false;
        isStudying = false;
        isConfiguring = true;
        StateHasChanged();
    }

    public void CancelConfiguring()
    {
        isConfiguring = false;
        StateHasChanged();
    }

    public void CancelRecapping()
    {
        isRecapping = false;
        StateHasChanged();
    }

    // New method to scroll to the top of the active content area
    private async Task ScrollToTop()
    {
        if (viewModule is null)
            return;

        string selector;
        if (isEditing)
        {
            selector = ".reader > textarea"; // EditMode selector
        }
        else if (isStudying)
        {
            selector = ".reader"; // StudyMode selector
        }
        else
        {
            selector = ".reader"; // ReadMode selector
        }

        await viewModule.InvokeVoidAsync("ViewHelpers.scrollToTop", selector);
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (viewModule is not null)
        {
            try
            {
                await viewModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
            }
        }
    }
}