@using Aixaminator.Data
@using Aixaminator.Data.Ai

<div class=@styles["container"]>
    <div class=@styles["tableContainer"]>
        <div class=@styles["tableWrapper"]>
            <table class=@styles["table"]>
                <thead>
                    <tr>
                        <th scope="col" class=@styles["headerCell"]>Action</th>
                        <th scope="col" class=@styles["headerCell"]>Provider</th>
                        <th scope="col" class=@styles["headerCell"]>Model</th>
                    </tr>
                </thead>
                <tbody class=@styles["tableBody"]>
                    @foreach (var (action, actionType) in AiSettings.ActionTypes)
                    {
                        <tr>
                            <td class=@styles["dataCell"]>@action</td>
                            <td class=@styles["dataCell"]>
                                <InputSelect @bind-Value="@model.Ai.ActionProviderMap[action]" @bind-Value:after="() => OnProviderChanged(action)" class=@styles["dropdown"]>
                                    <option value="">Select Provider</option>
                                    @foreach (var provider in model.Ai.AiProviders)
                                    {
                                        <option value="@provider.Name">@AiSettings.ProviderNames[provider.Name]</option>
                                    }
                                </InputSelect>
                            </td>
                            <td class=@styles["dataCell"]>
                                <InputSelect @bind-Value="@model.Ai.ActionModelMap[action]" class=@styles["dropdown"]>
                                    <option value="">Select Model</option>
                                    @foreach (var model in ModelsForAction(action))
                                    {
                                        <option value="@model">@model</option>
                                    }
                                </InputSelect>
                            </td>
                        </tr>
                    }
                    @foreach (var action in unavailableActions)
                    {
                        <tr>
                            <td class=@styles["placeholderCell"]>@action</td>
                            <td colspan="2" class=@styles["placeholderCell"]>Not yet available on macOS or Linux</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


@code {
    [CascadingParameter]
    public EditContext editContext { get; set; }
    
    [Parameter]
    public EventCallback OnUpdate { get; set; }

    private ApplicationSettings model => (ApplicationSettings)editContext.Model;
    
    private Dictionary<string, string> styles = new()
    {
        { "container", "container mx-auto" },
        { "tableContainer", "mt-4 flow-root" },
        { "tableWrapper", "inline-block min-w-full py-2 align-middle" },
        { "table", "min-w-full divide-y divide-gray-300" },
        { "headerCell", "py-3.5 px-3 text-left text-sm font-semibold text-gray-900" },
        { "tableBody", "divide-y divide-gray-200" },
        { "dataCell", "px-3 py-4 text-sm whitespace-nowrap text-gray-900" },
        { "dropdown", "block border border-gray-300 p-0.5 rounded-sm" },
        { "placeholderCell", "px-3 py-4 text-sm whitespace-nowrap text-gray-400 italic" }
    };

    // Placeholders for actions that relied on the Windows-only vector store
    private static readonly string[] unavailableActions = { "Document Splitting", "Document Classification" };
    
    protected override void OnInitialized()
    {
        model.Ai.InitializeActionMaps();
    }

    private void OnProviderChanged(string action)
    {
        var actionType = AiSettings.ActionTypes[action];
        var provider = model.Ai.ActionProviderMap[action];
        model.Ai.ActionModelMap[action] = AiSettings.AvailableModels[provider][actionType].Keys.First();
        editContext.NotifyFieldChanged(new FieldIdentifier(model, nameof(ApplicationSettings.Ai)));
    }

    private List<string> ModelsForAction(string action)
    {
        if (!model.Ai.ActionProviderMap.TryGetValue(action, out var provider) || string.IsNullOrEmpty(provider))
        {
            return new List<string>();
        }
        var actionType = AiSettings.ActionTypes[action];
        return AiSettings.AvailableModels[provider][actionType].Keys.ToList();
    }
}