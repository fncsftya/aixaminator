@page "/settings"

@using Aixaminator.Data
@using Aixaminator.Services

@inject ISettingsService SettingsService
@inject IAiConnection AiConnection

<div class="flex gap-x-4 items-baseline">
    <h3>Application Settings</h3>
    @if (status is not null)
    {
        <span class="text-sm">@status</span>
    }
</div>

<EditForm EditContext="editContext" FormName="EditSettings" class="p-4 space-y-4">
    <DataAnnotationsValidator />

    <div class="relative">
        <div class="absolute inset-0 flex items-center" aria-hidden="true">
            <div class="w-full border-t border-gray-300"></div>
        </div>
        <div class="relative flex justify-start">
            <span class="bg-white pr-3 text-base font-semibold text-gray-900">AI</span>
        </div>
    </div>

    @* AI Providers Management *@
    <Providers OnUpdate="() => StateHasChanged()" />

    <div class="relative">
        <div class="absolute inset-0 flex items-center" aria-hidden="true">
            <div class="w-full border-t border-gray-300"></div>
        </div>
        <div class="relative flex justify-start">
            <span class="bg-white pr-3 text-base font-semibold text-gray-900">Display</span>
        </div>
    </div>

    @* Display settings *@
    <div class="container mx-auto flex flex-col gap-y-4">
        <label for="sf__bg-color" class="w-fit">
            <span class="block text-sm/6 font-medium text-gray-900">Background Color</span>
            <div class="flex gap-x-2 items-center">
                <div class="rounded-sm overflow-hidden w-[30px] h-[30px] border border-gray-300">
                    <InputText @bind-value="Model.BackgroundColor" type="color" id="sf__bg-color" />
                </div>
                <div>
                    <InputText @bind-Value="Model.BackgroundColor" type="text" class="border border-gray-300 p-0.5 rounded-sm" />
                </div>
            </div>
            <ValidationMessage For="@(() => Model.BackgroundColor)" />
        </label>

        <label for="sf__fg-color" class="w-fit">
            <span class="block text-sm/6 font-medium text-gray-900">Text Color</span>
            <div class="flex gap-x-2 items-center">
                <div class="rounded-sm overflow-hidden w-[30px] h-[30px] border border-gray-300">
                    <InputText @bind-value="Model.ForegroundColor" type="color" id="sf__fg-color" />
                </div>
                <div>
                    <InputText @bind-Value="Model.ForegroundColor" type="text" class="border border-gray-300 p-0.5 rounded-sm" />
                </div>
            </div>
            <ValidationMessage For="@(() => Model.ForegroundColor)" />
        </label>

        <label for="sf__font-family" class="w-fit">
            <span class="block text-sm/6 font-medium text-gray-900">Font</span>
            <InputSelect @bind-Value="Model!.FontFamily" class="block border border-gray-300 p-0.5 rounded-sm" id="sf__font-family">
                @foreach (var font in ApplicationSettings.FontFamilies.Keys)
                {
                    <option value=@font>@font</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => Model.FontFamily)" />
            <span class="block text-gray-400 text-sm">The style of the text displayed in the reader.</span>
        </label>

        <label for="sf__font-size" class="w-fit">
            <span class="block text-sm/6 font-medium text-gray-900">Font Size</span>
            <InputSelect @bind-Value="Model!.FontSize" class="block border border-gray-300 p-0.5 rounded-sm" id="sf__font-size">
                @foreach (var size in ApplicationSettings.ValidFontSizes)
                {
                    <option value=@size>@size</option>
                }
            </InputSelect>
            <ValidationMessage For="@(() => Model.FontSize)" />
            <span class="block text-gray-400 text-sm">The size of the text displayed in the reader.</span>
        </label>
    </div>

    <p class="text-sm">Reader Preview</p>
    <div style=@PreviewStyle()>
        The quick brown fox jumps over the lazy dog.
    </div>
</EditForm>

@code {
    private ApplicationSettings? Model { get; set; }
    private EditContext editContext;

    private string? status = null;

    protected override void OnInitialized()
    {
        Model ??= SettingsService.Settings;
        editContext = new(Model);
        editContext.OnFieldChanged += HandleFieldChanged;
    }

    private void HandleFieldChanged(object? sender, FieldChangedEventArgs e)
    {
        if (editContext.Validate())
        {
            SaveSettings();
        }
        // TODO handle error
    }
    
    private async void HandleSettingsChanged()
    {
        status = "Saving...";
        StateHasChanged();

        try
        {
            await SettingsService.SaveSettings();
            status = "Saved!";
        }
        catch (Exception _)
        {
            status = "Failed to save settings.";
        }

        StateHasChanged();
    }
    
    private void SaveSettings()
    {
        status = "Saving...";
        StateHasChanged();

        try
        {
            SettingsService.SaveSettingsSync();
            status = "Saved!";
        }
        catch (Exception _)
        {
            status = "Failed to save settings.";
        }

        StateHasChanged();
    }

    public string PreviewStyle()
    {
        Dictionary<string, string> styles = new()
        {
            { "padding", "1rem" },
            { "margin-top", "0.5rem" },
            { "font-weight", "normal" },
            { "font-size", $"{Model!.FontSize}pt" },
            { "font-family", ApplicationSettings.FontFamilies[Model!.FontFamily] },
            { "background-color", Model!.BackgroundColor },
            { "color", Model!.ForegroundColor }
        };

        return string.Join(";", styles.Select(x => $"{x.Key}:{x.Value}"));
    }
}