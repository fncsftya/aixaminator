@using Aixaminator.Data
@using Aixaminator.Data.Ai
@using Aixaminator.Services

@inject IAiConnection AiConnection

<div class=@styles["container"]>
  <div class=@styles["table-container"]>
      <div class=@styles["table-wrapper"]>
        <table class=@styles["table"]>
          <thead>
            <tr>
              <th scope="col" class=@styles["th-actions"]>
                <span class="sr-only">Connection</span>
              </th>
              <th scope="col" class=@styles["th-first"]>Provider</th>
              <th scope="col" class=@styles["th"]>API Key</th>
              <th scope="col" class=@styles["th-actions"]>
                <span class="sr-only">Actions</span>
              </th>
            </tr>
          </thead>
          <tbody class=@styles["tbody"]>
            @foreach (var provider in model.Ai.AiProviders)
            {
                <tr>
                    <td class=@styles["td-connect"]>
                        <button type="button" class="premium-feature" @onclick="() => TestProviderConnection(provider)">
                            @if (connectionResults.ContainsKey(provider.Name))
                            {
                                if (connectionResults[provider.Name])
                                {
                                    <span>Connected!</span>
                                }
                                else
                                {
                                    <span>Failed</span>
                                }
                            }
                            else
                            {
                                <span>Check Connection</span>
                            }
                        </button>
                    </td>
                    <td class=@styles["td-first"]>@AiSettings.ProviderNames[provider.Name]</td>
                    <td class=@styles["td"]>@TruncateApiKey(provider.ApiKey)</td>
                    <td class=@styles["td-actions"]>
                        <button type="button" class="negative" @onclick="(() => RemoveProvider(provider))">Remove</button>
                    </td>
                </tr>
            }
          </tbody>
        </table>
      </div>
  </div>
</div>

@code {
    [CascadingParameter]
    public EditContext editContext { get; set; }

    [Parameter]
    public EventCallback OnUpdate { get; set; }

    private ApplicationSettings model => (ApplicationSettings)editContext.Model;

    private Dictionary<string, bool> connectionResults = new();

    private Dictionary<string, string> styles = new()
    {
        { "container", "container mx-auto" },
        { "table-container", "mt-4 flow-root" },
        { "table-wrapper", "inline-block min-w-full py-2 align-middle" },
        { "table", "min-w-full table-fixed divide-y divide-gray-300" },
        { "th-first", "w-40 py-3.5 pr-3 pl-4 text-left text-sm font-semibold text-gray-900 sm:pl-0" },
        { "th", "w-auto py-3.5 px-3 text-left text-sm font-semibold text-gray-900" },
        { "th-actions", "w-48 relative py-3.5 pr-4 pl-3 sm:pr-0" },
        { "tbody", "divide-y divide-gray-200" },
        { "td-first", "w-40 py-4 pr-3 pl-4 text-sm font-medium whitespace-nowrap text-gray-900 sm:pl-0" },
        { "td", "w-auto py-4 px-3 text-sm whitespace-nowrap text-gray-500 overflow-hidden text-ellipsis" },
        { "td-connect", "w-48 py-4 px-3 text-sm whitespace-nowrap text-gray-500 overflow-hidden text-ellipsis" },
        { "td-actions", "w-40 relative py-4 pr-4 pl-3 text-right text-sm font-medium whitespace-nowrap sm:pr-0" },
    };

    private async Task RemoveProvider(AiProvider providerToRemove)
    {
        model.Ai.RemoveProvider(providerToRemove);
        OnFieldChanged();
        await OnUpdate.InvokeAsync();
    }

    private void OnFieldChanged()
    {
        editContext.NotifyFieldChanged(new FieldIdentifier(model, nameof(ApplicationSettings.Ai)));
    }

    private string TruncateApiKey(string apiKey)
    {
        if (apiKey.Length <= 8)
        {
            return "****";
        }

        return apiKey.Substring(0, 4) + "****" + apiKey.Substring(apiKey.Length - 4);
    }

    public async Task TestProviderConnection(AiProvider provider)
    {
        var result = await AiConnection.TestConnection(provider.Name, provider.ApiKey);
        connectionResults[provider.Name] = result;
        StateHasChanged();
    }
}