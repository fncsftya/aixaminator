@using Aixaminator.Data;

@inject AppDbContext DbContext

<h3>Study notes for @(ShowAll ? "document" : $"part {Part + 1}")</h3>

@if (AllNotes.Count == 0)
{
    <p>You don't have any notes for this part yet.</p>
}
else
{
    @foreach (var note in AllNotes.OrderByDescending(n => n.Id))
    {
        <div class="overflow-hidden rounded-lg bg-white shadow-sm mt-4">
            <div class="px-4 py-5 sm:p-6">
                <div class="flex justify-between">
                    <div class="flex-1 flex gap-x-1 items-center mb-2">
                        @if (note.IsQuestion)
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z" />
                            </svg>
                        }
                        else if (note.IsHighlight)
                        {
                            <span class="rounded-full size-4 @(note.HighlightColour)">&nbsp;</span>
                        }
                        else
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
                            </svg>
                        }
                        <h4 class="text-sm font-medium">@NoteKind(note)</h4>
                    </div>

                    <button class="negative" title="Delete this note" @onclick="@(async () => await DeleteNote(note))">
                        <span>Delete</span>
                    </button>
                </div>

                @if (note.Context is not null)
                {
                    <div>
                        <label for="note-text" class="block text-sm/6 font-medium text-gray-900">Reference text</label>
                        <p class="text-sm">@note.Context</p>
                    </div>
                }

                @if (note.IsQuestion)
                {
                    <div>
                        <label for="note-text" class="block text-sm/6 font-medium text-gray-900">Question</label>
                        <p class="text-sm">@note.Text</p>
                    </div>


                    <div>
                        <label for="note-text" class="block text-sm/6 font-medium text-gray-900">Answer</label>
                        @if (showQuestionState[note.Id])
                        {
                            <div class="flex items-center gap-x-2">
                                <button class="secondary" title="Hide answer" @onclick="() => { showQuestionState[note.Id] = false; }">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88" />
                                    </svg>
                                </button>
                                <span class="text-sm">@note.Answer</span>
                            </div>
                        }
                        else
                        {
                            <button class="primary" @onclick="() => { showQuestionState[note.Id] = true; }">Show Answer</button>
                        }
                    </div>
                }
                else
                {
                    <p>@note.Text</p>
                }
            </div>
        </div>
    }
}

@code {
    [CascadingParameter]
    public Document? document { get; set; }

    [Parameter]
    public int Part { get; set; }

    [Parameter]
    public bool ShowAll { get; set; }

    [Parameter]
    public EventCallback OnUpdate { get; set; }

    private Dictionary<int, bool>? showQuestionState;
    private List<Note> AllNotes {
        get
        {
            if (document is null)
            {
                return [];
            }

            var notes = document.Notes;
            if (ShowAll)
            {
                return notes.ToList();
            }
            return notes.Where(n => n.DocumentPartNumber == Part).ToList();
        }
    }

    protected override void OnParametersSet()
    {
        showQuestionState ??= new();
        foreach (var note in AllNotes.Where(n => n.IsQuestion && !showQuestionState.ContainsKey(n.Id)))
        {
            showQuestionState[note.Id] = false;
        }
    }

    public string NoteKind(Note note)
    {
        if (note.IsQuestion)
        {
            return "Question";
        }
        else if (note.IsHighlight)
        {
            return "Highlight";
        }
        return "Note";
    }

    public async Task DeleteNote(Note note)
    {
        if (document is null)
        {
            return;
        }

        document.Notes.Remove(note);
        DbContext.Set<Note>().Remove(note);
        await DbContext.SaveChangesAsync();
        StateHasChanged();
        if (OnUpdate.HasDelegate)
        {
            await OnUpdate.InvokeAsync();
        }
    }
}