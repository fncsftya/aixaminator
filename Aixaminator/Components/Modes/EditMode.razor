@using Aixaminator.Data
@using Aixaminator.Services
@using Microsoft.JSInterop
@using System.Text.RegularExpressions
@using System.Text

@inject IAiConnection AiConnection
@inject IJSRuntime JS

@implements IAsyncDisposable

<div class="h-full flex flex-col gap-y-2">
    @if (Active)
    {
        <div class="reader flex-1 overflow-y-auto p-4 bg-white rounded-sm flex flex-col"
            style="@ReaderStyle">
            <textarea value="@EditedText" @oninput="HandleTextChanged" class="w-full h-full resize-none"></textarea>
        </div>

        <div class="flex place-content-center items-center">
            <div class="flex flex-col items-center">
                <button class="block @(CleaningFailed ? "negative" : "premium-feature") w-40" @onclick="CleanPage" disabled=@(IsCleaning || CleaningFailed)>
                    @if (IsCleaning)
                    {
                        <span>Cleaning Part @(ForPart + 1)...</span>
                    }
                    else if (CleaningFailed)
                    {
                        <span>Failed</span>
                    }
                    else
                    {
                        <span>Clean Text</span>
                    }
                </button>
                <span class="text-gray-400 text-xs">Note: This may make mistakes, please review the output.</span>
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public Document Document { get; set; }

    [Parameter]
    public int Part { get; set; }

    [Parameter]
    public string PartText { get; set; }

    [Parameter]
    public bool Active { get; set; }

    [Parameter]
    public string ReaderStyle { get; set; }

    [Parameter]
    public bool IsCleaning { get; set; }

    [Parameter]
    public bool CleaningFailed { get; set; }

    [Parameter]
    public int ForPart { get; set; }

    [Parameter]
    public string EditedText { get; set; }

    [Parameter]
    public EventCallback<string> EditedTextChanged { get; set; }

    [Parameter]
    public EventCallback OnCleanPage { get; set; }

    private IJSObjectReference? module;
    
    private Dictionary<string, object> textareaAttrs = new Dictionary<string, object>
    {
        { "class", "w-full h-full resize-none" }
    };

    private Regex newLineRegex = new(@"\r?\n");
    private List<Regex> cleanerRegexes = [
        new(@"^\d+\D+$"),
        new(@"^\D+\d+$"),
        new(@"^\d+$"),
    ];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Modes/EditMode.razor.js");
        }
    }

    private async Task HandleTextChanged(ChangeEventArgs e)
    {
        if (e.Value is string newValue)
        {
            await EditedTextChanged.InvokeAsync(newValue);
        }
    }

    public async Task CleanPage()
    {
        await OnCleanPage.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try
            {
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
            catch (JSException)
            {
            }
        }
    }
} 